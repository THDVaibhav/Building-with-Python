''''
factoral of 0 = 1
factorial of 1 = 1
factoral of 2 = 1*2
factoral of 3 = 1*2*3
factoral of 4 = 1*2*3*4
factoral of 5 = 1*2*3*4*5

factorial(n) = n*(n-1)*......3*2*1
factoral(n) = n * factorial of (n-1)

'''

def factorial (n):
    if n ==0 or n == 1:
        return 1
    return n * factorial(n-1)

n = int(input("Enter a number: "))
print("The factorial ",factorial(n))
